package com.breezybuilds.cheatstation.ui

import android.content.Intent
import android.os.Bundle
import android.view.View
import android.view.ViewGroup
import android.widget.LinearLayout
import androidx.appcompat.app.AppCompatActivity
import com.google.android.material.card.MaterialCardView
import com.breezybuilds.cheatstation.app

class WelcomeActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val root = Ui.vbox(this, 20)
        Ui.edgeToEdge(root)

        val title = Ui.tv(this, "Breezy's Cheat Station", 28f, bold = true)
        root.addView(title, Ui.lp())

        val subtitle = Ui.tv(
            this,
            "Choose a system to get started.",
            16f,
            secondary = true
        )
        root.addView(subtitle, Ui.lp())

        root.addView(
            systemButton("Nintendo 3DS", "Cheats, game scanning and installation.") {
                startActivity(Intent(this, MainActivity::class.java))
            },
            Ui.lp().apply { topMargin = Ui.dp(this@WelcomeActivity, 12) }
        )

        root.addView(
            systemButton("PlayStation 2", "NetherSX2 / AetherSX2 PNACH cheats.") {
                startActivity(Intent(this, Ps2Activity::class.java))
            },
            Ui.lp()
        )

        root.addView(
            systemButton("Nintendo Wii", "Wii cheat management — coming soon.", false) {},
            Ui.lp()
        )

        root.addView(
            systemButton("Nintendo GameCube", "GameCube cheat management — coming soon.", false) {},
            Ui.lp()
        )

        root.addView(
            Ui.button(this, "Settings") {
                startActivity(Intent(this, SettingsActivity::class.java))
            },
            Ui.lp().apply { topMargin = Ui.dp(this@WelcomeActivity, 12) }
        )

        setContentView(root)
    }

    private fun systemButton(
        title: String,
        description: String,
        enabled: Boolean = true,
        onClick: () -> Unit
    ): MaterialCardView {
        val card = MaterialCardView(this).apply {
            radius = Ui.dp(this@WelcomeActivity, 16).toFloat()
            setCardElevation(Ui.dp(this@WelcomeActivity, 2).toFloat())
            isClickable = enabled
            isFocusable = enabled
            alpha = if (enabled) 1f else 0.55f
            if (enabled) setOnClickListener { onClick() }
        }

        val box = Ui.vbox(this, 18)
        box.addView(Ui.tv(this, title, 20f, bold = true), Ui.lp())
        box.addView(Ui.tv(this, description, 13f, secondary = true), Ui.lp())

        card.addView(
            box,
            ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT
            )
        )

        return card
    }
}
